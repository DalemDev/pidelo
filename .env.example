# Variables de entorno de Pídelo. Copia este archivo a .env (desarrollo) o configúralas en la
# plataforma de despliegue (producción). En producción la app se niega a arrancar si falta alguna
# obligatoria y muestra cuál (src/server/config/env.ts → assertProductionEnv).

# --- Base de datos -----------------------------------------------------------------------------
# Desarrollo: la de docker compose (npm run db:up).
DATABASE_URL="postgresql://pidelo:pidelo@localhost:5432/pidelo"
# Producción (Neon/Supabase): DATABASE_URL = URL "pooled"; DIRECT_URL = URL directa (para migraciones).
# DIRECT_URL=""
# Pruebas de integración (base dedicada; su nombre debe contener "test"). Ver README → Pruebas.
# TEST_DATABASE_URL="postgresql://pidelo:pidelo@localhost:5432/pidelo_test"

# --- Seguridad (obligatorias en producción) ------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto"
# Protege /api/cron/liberar (Vercel Cron lo envía como Bearer).
CRON_SECRET=""
# Cifrado de número de cuenta y cédula (AES-256-GCM). 32 bytes en base64. NO cambiarla después de
# tener datos cifrados (se perderían). En desarrollo, si falta, se deriva de SESSION_SECRET.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=""

# --- Identificación de la empresa (obligatorias en producción) ---------------------------------
# Se muestran en el pie de página, los términos y la política de privacidad.
# LEGAL_COMPANY_NAME="Pídelo S.A.S."
# LEGAL_RUC=""
# LEGAL_ADDRESS="Av. ..., Quito, Ecuador"
# SUPPORT_EMAIL="soporte@pidelo.ec"
# PRIVACY_EMAIL="privacidad@pidelo.ec"

# --- Correo transaccional (obligatorio en producción) ------------------------------------------
# En desarrollo, sin RESEND_API_KEY, los correos se imprimen en la consola del servidor.
# APP_URL="https://pidelo.ec"
# RESEND_API_KEY=""
# MAIL_FROM="Pídelo <no-responder@pidelo.ec>"

# --- Asistente y moderación con IA (opcional) ---------------------------------------------------
# Sin clave se usan el clasificador local y el filtro por reglas.
ANTHROPIC_API_KEY=""

# --- Comprobantes de pago -------------------------------------------------------------------------
# "local" (solo desarrollo) o "s3" (obligatorio en producción: S3 o Cloudflare R2, bucket PRIVADO).
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION="auto"            # "auto" para R2; p. ej. "us-east-1" para S3
# S3_ENDPOINT=""              # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (vacío para S3)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Cuenta de la empresa para recibir pagos (obligatorio en producción) -------------------------
PAY_BANK_NAME=""
PAY_ACCOUNT_TYPE=""
PAY_ACCOUNT_NUMBER=""
PAY_HOLDER=""
PAY_RUC=""
PAY_DEUNA=""

# --- Opciones avanzadas ----------------------------------------------------------------------------
# "1" ejecuta los trabajos programados al navegar también en producción (solo si no hay cron).
# RUN_JOBS_ON_REQUEST=""
# "1" permite el pago con tarjeta simulado en producción (solo para un demo; nunca con usuarios reales).
# ALLOW_SIMULATED_PAYMENTS=""
