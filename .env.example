# --- Base de datos -----------------------------------------------------------------------------
# Desarrollo: la de docker compose (npm run db:up).
DATABASE_URL="postgresql://pidelo:pidelo@localhost:5432/pidelo"
# Producción (Neon/Supabase): DATABASE_URL = URL "pooled"; DIRECT_URL = URL directa (para migraciones).
# DIRECT_URL=""

# --- Seguridad ---------------------------------------------------------------------------------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto"
# Protege /api/cron/liberar (Vercel Cron lo envía automáticamente como Bearer).
CRON_SECRET=""

# --- IA (opcional) -----------------------------------------------------------------------------
# Sin clave se usa un clasificador local.
ANTHROPIC_API_KEY=""

# --- Comprobantes de pago ------------------------------------------------------------------------
# "local" (solo desarrollo) o "s3" (obligatorio en producción: S3 o Cloudflare R2, bucket PRIVADO).
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION="auto"            # "auto" para R2; p. ej. "us-east-1" para S3
# S3_ENDPOINT=""              # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (vacío para S3)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Cuenta de la empresa para cobros (obligatorio en producción) -----------------------------
PAY_BANK_NAME=""
PAY_ACCOUNT_TYPE=""
PAY_ACCOUNT_NUMBER=""
PAY_HOLDER=""
PAY_RUC=""
PAY_DEUNA=""
